{
  "name": "kgesture",
  "version": "0.1.9",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A lean, local-first Chromium mouse gesture extension",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/check-locales.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "bench": "node --import tsx scripts/bench.ts",
    "bench:overlay": "node scripts/bench-overlay.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "pack": "pnpm build && node scripts/pack.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
